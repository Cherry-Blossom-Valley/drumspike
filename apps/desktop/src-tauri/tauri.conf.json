{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drum Spike",
  "version": "0.9.6",
  "identifier": "com.cbv.drumspike",
  "build": {
    "frontendDist": "../../../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Drum Spike",
        "url": "index.html",
        "width": 1600,
        "height": 1000,
        "visible": false,
        "backgroundColor": "#14161a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright 2026 Cherry Blossom Valley (Wolfgang Frank). Source code Apache-2.0.",
    "license": "Apache-2.0",
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["drumspike"],
        "name": "Drum Spike project",
        "description": "Drum Spike project document",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {"identifier": "com.cbv.drumspike.project", "conformsTo": ["public.json", "public.data"]}
      },
      {
        "ext": [],
        "name": "Project folder",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": ["public.folder"]
      }
    ],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "../THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
