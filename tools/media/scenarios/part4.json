{
  "name": "part4",
  "title": "Screen recording, part 4: what is new in 0.9.3 (#403)",
  "script": "docs/product/scripts/rec-part4.md",
  "standard": true,
  "drift_limit_ms": 10,
  "viewport": {"width": 1920, "height": 1080},
  "device_scale_factor": 2,
  "skip": [],
  "seed": "demo",
  "plugins": true,
  "narration": {"tts_out": "~/.cache/drumspike/media/tts-out/rec-part4"},
  "out": "~/.cache/drumspike/media/rec/part4.mp4",
  "scenes": [
    {"id": "p4-export", "steps": [
      {"do": "caption", "text": "Track > Export Selected Tracks…"},
      {"do": "zoom_to", "track": "k_in", "t": 16.0938, "span": 5},
      {"do": "click", "sel": ".track[data-name=\"k_in\"] .thead .tname", "timeout": 15, "err": "the kick selected"},
      {"do": "hold", "s": 1.5},
      {"do": "show_dest", "text": "~/Music/Drum Spike/Exports",
       "err": "the destination in the neutral home-relative form before the dialog opens (shots.py's EXPORTS_SHOWN); the show keeps against the app's own exRender re-renders"},
      {"do": "key", "press": "Shift+Meta+E"},
      {"do": "visible", "sel": "#exportModal", "timeout": 30, "err": "the Export dialog with the selected track"},
      {"do": "wait", "cond": "() => document.querySelector('#exScopeSel').checked && document.querySelector('#exSpikes').checked && document.querySelector('#exSpikeSynth').checked", "timeout": 15, "err": "the dialog shows the selected track and the spike defaults"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#exMidi", "timeout": 15, "err": "MIDI off: this export is about the spikes"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#exSpikeAudio", "timeout": 15, "err": "the spike type Audio"},
      {"do": "wait", "cond": "() => document.querySelector('#exSpikeAudio').checked && !document.querySelector('#exMidi').checked", "timeout": 15, "err": "spike type Audio, MIDI off"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#exGo", "timeout": 15, "err": "Export"},
      {"do": "wait", "cond": "() => !EX.busy && EX.done > 0", "timeout": 120,
       "err": "the audio spike export finished (EX.done > d0 races a fast export: d0 is read after the export already completed; the summary text below asserts which export)"},
      {"do": "show_dest", "text": "~/Music/Drum Spike/Exports", "err": "the destination again (every exRender of the app re-asserts it)"},
      {"do": "text", "sel": "#exResultText", "contains": "audio spike", "timeout": 15, "err": "the summary names the audio spike file"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#exSpikeSynth", "timeout": 15, "err": "the spike type Synthetic: the click spike"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#exGo", "timeout": 15, "err": "Export"},
      {"do": "wait", "cond": "() => !EX.busy", "timeout": 120, "err": "the click spike export finished (the summary text below asserts it)"},
      {"do": "text", "sel": "#exResultText", "contains": "1 spike file", "timeout": 15, "err": "the summary names the click spike file"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#exCancel", "timeout": 15, "err": "the dialog closed"},
      {"do": "wait", "cond": "() => document.querySelector('#exportModal').classList.contains('hidden')", "timeout": 15, "err": "the Export dialog closed"},
      {"do": "hold", "s": 1.5},
      {"do": "answer_pick", "path": "{projects}/Demo/Exports"},
      {"do": "key", "press": "Shift+Meta+I"},
      {"do": "visible", "sel": "#tracksModal", "timeout": 30, "err": "the Add Tracks list of the export folder"},
      {"do": "wait", "cond": "() => { const a = document.querySelector('#tracksRows .urow[data-stem=\"k_in_audio_spike\"]'); const b = document.querySelector('#tracksRows .urow[data-stem=\"k_in_spike\"]'); return !!a && !!b && a.querySelector('.uuse').checked && b.querySelector('.uuse').checked; }", "timeout": 30, "err": "the two spike WAVs of the kick, checked"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#tracksAdd", "timeout": 15, "err": "Add 2 tracks"},
      {"do": "wait", "cond": "() => S.order.length === 15", "timeout": 120, "err": "the two spike tracks added"},
      {"do": "wait", "cond": "() => document.querySelector('#tracksModal').classList.contains('hidden')", "timeout": 30, "err": "the Add Tracks dialog closed"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": ".track[data-name=\"k_in\"] .thead .tname", "timeout": 15, "err": "the kick selected again"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Tab"},
      {"do": "wait", "cond": "() => !document.querySelector('#ilFields').classList.contains('hidden') && document.querySelector('#ilSample').value.length > 0", "timeout": 15, "err": "a kick hit selected"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "5"},
      {"do": "wait", "cond": "() => S.view && (S.view.t1 - S.view.t0) <= 0.051", "timeout": 15, "err": "the 50 ms zoom at the kick hit"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": ".track[data-name=\"k_in_audio_spike\"] .thead .tname", "timeout": 15, "err": "the audio spike track scrolled into view"},
      {"do": "hold", "s": 3.0}
    ]},
    {"id": "p4-detector", "area_sel": "#inspector", "steps": [
      {"do": "caption", "text": "The Detector select of the Inspector"},
      {"do": "click", "sel": ".track[data-name=\"k_in\"] .thead .tname", "timeout": 15, "err": "the kick selected (the Inspector follows)"},
      {"do": "hold", "s": 1.5},
      {"do": "show_key", "press": "Alt+I", "sel": "#inspector", "timeout": 10, "err": "the Inspector"},
      {"do": "wait", "cond": "() => [...document.querySelectorAll('#insParams .pDetector option')].some(o => o.value === 'json-hits')", "timeout": 30, "err": "the Detector select lists JSON Hits (the plug-in of the recording home)"},
      {"do": "hold", "s": 1.5},
      {"do": "select", "sel": "#insParams .pDetector", "value": "json-hits", "timeout": 15, "err": "the plug-in picked"},
      {"do": "visible", "sel": "#pluginLicenceModal", "timeout": 30, "err": "the licence dialog before the first use"},
      {"do": "wait", "cond": "() => { const t = document.querySelector('#plIntro').textContent || ''; return t.includes('json_hits.py') && t.includes('~/Library/'); }", "timeout": 15, "err": "the licence shows the executable in the neutral home form"},
      {"do": "hold", "s": 3.0},
      {"do": "click", "sel": "#plAccept", "timeout": 15, "err": "Accept and use"},
      {"do": "wait", "cond": "() => document.querySelector('#pluginLicenceModal').classList.contains('hidden')", "timeout": 15, "err": "the licence accepted"},
      {"do": "text", "sel": "#stMsg", "contains": "licence accepted", "timeout": 15, "err": "the status line: licence accepted, the plug-in runs on the next re-analyze"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#insParams .bReanalyze", "timeout": 15, "err": "Re-analyze with the plug-in"},
      {"do": "wait", "cond": "() => !analysisRunning", "timeout": 180, "err": "the re-analyze with the plug-in finished"},
      {"do": "wait", "cond": "() => (S.events['k_in'] || []).length === 21", "timeout": 30, "err": "the plug-in's 21 hits (every third kick of the demo session), refined to the attack"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p4-sens", "area_sel": "#inspector", "steps": [
      {"do": "caption", "text": "The Sensitivity slider"},
      {"do": "click", "sel": ".track[data-name=\"s_top\"] .thead .tname", "timeout": 15, "err": "the snare selected (the Inspector follows)"},
      {"do": "wait", "cond": "() => { const s = document.querySelector('#insParams .pSens'); return !!s && !s.disabled; }", "timeout": 15, "err": "the Sensitivity slider of the snare"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#insParams .pSens", "timeout": 15, "err": "the thumb takes the click (the value jumps, the re-pick starts)"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Shift+Up"},
      {"do": "wait", "cond": "n => (S.events['s_top'] || []).length > n", "arg": "() => (S.events['s_top'] || []).length", "timeout": 60, "err": "the re-pick found more hits"},
      {"do": "hold", "s": 2.0},
      {"do": "key", "press": "Shift+Up"},
      {"do": "wait", "cond": "n => (S.events['s_top'] || []).length > n", "arg": "() => (S.events['s_top'] || []).length", "timeout": 60, "err": "the second re-pick found more hits"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p4-keep", "area_sel": "#inspector", "steps": [
      {"do": "caption", "text": "Re-analyze offers Keep"},
      {"do": "click", "sel": ".track[data-name=\"s_top\"] .thead .tname", "timeout": 15, "err": "the snare stays selected (the click leaves the slider)"},
      {"do": "hold", "s": 1.5},
      {"do": "blur", "err": "the slider's focus dropped (the fresh-page state); the app's key guard would swallow the Tab on the range input otherwise"},
      {"do": "wait", "cond": "() => !hgRepickBusy()", "timeout": 60, "err": "the sensitivity re-pick of p4-sens is stored (a re-pick refuses hit edits, and its store clears the hit selection)"},
      {"do": "key", "press": "Tab"},
      {"do": "wait", "cond": "() => !document.querySelector('#ilFields').classList.contains('hidden') && document.querySelector('#ilSample').value.length > 0", "timeout": 15, "err": "a snare hit selected"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#ilVel", "timeout": 15, "err": "the velocity field of the info line"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Meta+A"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "4"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "0"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Return"},
      {"do": "wait", "cond": "() => (S.events['s_top'] || []).some(e => e.edited === true)", "timeout": 30, "err": "the hand velocity applied (the hit is a kept edit)"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#insParams .bReanalyze", "timeout": 15, "err": "Re-analyze"},
      {"do": "visible", "sel": "#reanalyzeModal", "timeout": 30, "err": "the dialog offers Keep for the velocity-only edit"},
      {"do": "hold", "s": 2.0},
      {"do": "click", "sel": "#raKeep", "timeout": 15, "err": "Keep edited hits"},
      {"do": "wait", "cond": "() => document.querySelector('#reanalyzeModal').classList.contains('hidden')", "timeout": 15, "err": "the dialog answered"},
      {"do": "wait", "cond": "() => !analysisRunning", "timeout": 180, "err": "the re-analyze finished"},
      {"do": "wait", "cond": "() => (S.events['s_top'] || []).some(e => e.edited === true)", "timeout": 30, "err": "the kept edit is back with the new detection"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p4-end", "steps": [
      {"do": "caption", "text": "Drum Spike 0.9.3"},
      {"do": "hold", "s": 4.0}
    ]}
  ]
}
