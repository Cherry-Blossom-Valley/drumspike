{
  "name": "part-learn",
  "title": "Screen recording: Learn, teach by example (guide chapter 11) (#428, #450)",
  "script": "docs/product/scripts/rec-learn.md",
  "standard": true,
  "drift_limit_ms": 10,
  "viewport": {"width": 1920, "height": 1080},
  "device_scale_factor": 2,
  "seed": "demo",
  "narration": {"tts_out": "~/.cache/drumspike/media/tts-out/rec-learn"},
  "out": "~/.cache/drumspike/media/rec/part-learn.mp4",
  "scenes": [
    {
      "id": "pl-ghost",
      "steps": [
        {"do": "caption", "text": "Hits > Forget This"},
        {"do": "zoom_to", "track": "s_top", "t": 7.0312, "span": 5},
        {"do": "drag", "track": "s_top", "lane": "wave", "from": 6.6, "to": 9.4,
         "wait_sel": true, "timeout": 10, "err": "the range over the ghost and its near copies selected"},
        {"do": "hold", "s": 1.5},
        {"do": "key", "press": "Shift+K"},
        {"do": "hold", "s": 1.5},
        {"do": "click", "sel": "#confirmModal button[data-act='keep']", "timeout": 30,
         "err": "the Learn guard answered: Keep (the first Forget This takes out the ghost and its near copies)"},
        {"do": "wait", "cond": "() => DSLearn.state().pending === 0", "timeout": 30,
         "err": "the Forget This stored"},
        {"do": "wait",
         "cond": "() => (S.events['s_top']||[]).some(e => e.filtered && Math.abs(e.t - 7.0312) <= 0.025)",
         "timeout": 15, "err": "the ghost greyed"},
        {"do": "wait", "cond": "() => /Forget This on [3-9] hits/.test((document.querySelector('#stMsg')||{textContent:''}).textContent)",
         "timeout": 10, "err": "the status line says Forget This on 3 or more hits"},
        {"do": "hold", "s": 2.0}
      ]
    },
    {
      "id": "pl-grey",
      "steps": [
        {"do": "caption", "text": "The marked hit and its near copies go grey"},
        {"do": "zoom_to", "track": "s_top", "t": 8.4, "span": 3},
        {"do": "wait", "cond": "() => (S.events['s_top']||[]).filter(e => e.filtered && Math.abs(e.t - 7.0312) <= 2.5).length >= 3",
         "timeout": 15, "err": "the marked hits and their near copies grey in the view (3 or more)"},
        {"do": "wait", "cond": "() => (document.querySelector('#stMsg')||{textContent:''}).textContent.includes('Learn takes')",
         "timeout": 10, "err": "the status line counts the grey hits"},
        {"do": "lane_click", "track": "s_top", "lane": "spike", "t": 8.5938},
        {"do": "hold", "s": 1.5},
        {"do": "lane_click", "track": "s_top", "lane": "spike", "t": 9.5312},
        {"do": "hold", "s": 1.5},
        {"do": "lane_click", "track": "s_top", "lane": "spike", "t": 7.0312},
        {"do": "hold", "s": 1.5},
        {"do": "drag", "track": "s_top", "lane": "wave", "from": 7.0312, "to": 9.5312,
         "wait_sel": true, "timeout": 10, "err": "the range over the marked hit and its near copies selected"},
        {"do": "hold", "s": 2.0}
      ]
    },
    {
      "id": "pl-add",
      "steps": [
        {"do": "caption", "text": "Hits > Learn This"},
        {"do": "zoom_to", "track": "s_top", "t": 18.5938, "span": 0.5},
        {"do": "drag", "track": "s_top", "lane": "wave", "from": 18.4438, "to": 18.7438,
         "wait_sel": true, "timeout": 10, "err": "the range over the missed stretch selected"},
        {"do": "hold", "s": 1.5},
        {"do": "key", "press": "k"},
        {"do": "wait", "cond": "() => DSLearn.state().pending === 0", "timeout": 30,
         "err": "the Learn This stored"},
        {"do": "wait",
         "cond": "() => (S.events['s_top']||[]).some(e => e.learned && Math.abs(e.t - 18.5938) <= 0.025)",
         "timeout": 15, "err": "the missed hit added, flagged as learned"},
        {"do": "hold", "s": 2.0}
      ]
    },
    {
      "id": "pl-histogram",
      "area_sel": "#inspector",
      "steps": [
        {"do": "caption", "text": "The Learn section of the Inspector"},
        {"do": "click", "sel": ".track[data-name=\"s_top\"] .thead .tname", "timeout": 15,
         "err": "s top selected (the Inspector follows the track context)"},
        {"do": "hold", "s": 1.5},
        {"do": "show_key", "press": "Alt+I", "sel": "#inspector", "timeout": 10,
         "err": "the Inspector"},
        {"do": "hold", "s": 1.5},
        {"do": "click", "sel": ".insSec[data-sec=\"detection\"] .insSecHead", "timeout": 15,
         "err": "the Detection section collapsed (the Learn section gets the room)"},
        {"do": "hold", "s": 1.5},
        {"do": "click", "sel": ".insSec[data-sec=\"velocity\"] .insSecHead", "timeout": 15,
         "err": "the Velocity section collapsed"},
        {"do": "hold", "s": 1.5},
        {"do": "click", "sel": ".insSec[data-sec=\"learn\"] .insSecHead", "timeout": 15,
         "err": "the Learn section opened"},
        {"do": "wait",
         "cond": "() => { const c = document.querySelector('#insParams .lnHist'); if (!c || c.classList.contains('hidden')) return false; const im = c.getContext('2d').getImageData(0, 0, c.width, c.height).data; for (let i = 3; i < im.length; i += 4) if (im[i] > 0) return true; return false; }",
         "timeout": 30, "err": "the Similarity histogram painted (the scores arrive)"},
        {"do": "wait",
         "cond": "() => { const r = document.querySelector('#insParams .lnRow'); return !!r && (r.querySelector('.lnCount')||{textContent:''}).textContent.includes('✓'); }",
         "timeout": 15, "err": "the counts line under the histogram"},
        {"do": "hold", "s": 3.0}
      ]
    },
    {
      "id": "pl-remove",
      "steps": [
        {"do": "caption", "text": "Hits > Remove Example"},
        {"do": "zoom_to", "track": "s_top", "t": 18.5938, "span": 0.5},
        {"do": "drag", "track": "s_top", "lane": "wave", "from": 18.4438, "to": 18.7438,
         "wait_sel": true, "timeout": 10, "err": "the example's range selected again"},
        {"do": "hold", "s": 1.5},
        {"do": "key", "press": "Alt+K"},
        {"do": "hold", "s": 1.5},
        {"do": "click", "sel": "#confirmModal button[data-act='keep']", "timeout": 30,
         "err": "the Learn guard answered: Keep (the removal re-filters and takes out the near copies)"},
        {"do": "wait", "cond": "() => DSLearn.state().pending === 0", "timeout": 30,
         "err": "the Remove Example stored"},
        {"do": "wait", "cond": "() => !(S.events['s_top']||[]).some(e => e.learned)",
         "timeout": 15, "err": "the added hits of the example went with it"},
        {"do": "hold", "s": 2.0}
      ]
    },
    {
      "id": "pl-end",
      "steps": [
        {"do": "caption", "text": "Drum Spike 0.9.3"},
        {"do": "hold", "s": 4.0}
      ]
    }
  ]
}
