{
  "name": "part2",
  "title": "Screen recording, part 2: check and fix (#337)",
  "script": "docs/product/scripts/rec-part2.md",
  "standard": true,
  "drift_limit_ms": 10,
  "viewport": {"width": 1920, "height": 1080},
  "device_scale_factor": 2,
  "skip": [],
  "seed": "demo",
  "narration": {"tts_out": "~/.cache/drumspike/media/tts-out/rec-part2"},
  "out": "~/.cache/drumspike/media/rec/part2.mp4",
  "scenes": [
    {"id": "p2-play", "area_sel": "#timeDisplay", "steps": [
      {"do": "caption", "text": "Transport > Half-Speed Play"},
      {"do": "hold", "s": 0.6},
      {"do": "key", "press": "Space"},
      {"do": "wait", "cond": "() => S.playing", "timeout": 15, "err": "playback started"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Space"},
      {"do": "wait", "cond": "() => !S.playing", "timeout": 15, "err": "playback stopped"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Shift+Space"},
      {"do": "wait", "cond": "() => S.playing", "timeout": 15, "err": "half-speed play started"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Space"},
      {"do": "wait", "cond": "() => !S.playing", "timeout": 15, "err": "half-speed play stopped"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Alt+Space"},
      {"do": "wait", "cond": "() => S.playing", "timeout": 15, "err": "play-and-return started"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Alt+Space"},
      {"do": "wait", "cond": "() => !S.playing", "timeout": 15, "err": "the playhead back where the play started"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p2-zoom", "area_sel": "#editor", "steps": [
      {"do": "caption", "text": "View > Zoom Presets > 5 ms"},
      {"do": "key", "press": "1"},
      {"do": "wait", "cond": "() => S.view && (S.view.t1 - S.view.t0) > 1", "timeout": 15, "err": "the whole session first (p1-zoom left the 5 ms view, the first preset would show nothing)"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "6"},
      {"do": "wait", "cond": "() => S.view && (S.view.t1 - S.view.t0) <= 0.006", "timeout": 15, "err": "the 5 ms zoom"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "5"},
      {"do": "wait", "cond": "() => S.view && (S.view.t1 - S.view.t0) <= 0.051", "timeout": 15, "err": "the 50 ms zoom"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "1"},
      {"do": "wait", "cond": "() => S.view && (S.view.t1 - S.view.t0) > 1", "timeout": 15, "err": "the whole session"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "T"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "R"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p2-step", "area_sel": ".track[data-name=\"s_top\"]", "steps": [
      {"do": "caption", "text": "Hits > Next Hit"},
      {"do": "zoom_to", "track": "s_top", "t": 8.5938, "span": 0.5},
      {"do": "key", "press": "Tab"},
      {"do": "wait", "cond": "() => document.querySelector('#ilSample') && document.querySelector('#ilSample').value.length > 0", "timeout": 15, "err": "a hit selected (the sample in the info line)"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "L"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "N"},
      {"do": "hold", "s": 1.5},
      {"do": "hide_key", "sel": "#overviewWrap", "press": "Alt+O", "timeout": 15, "err": "the overview hidden first (it shows by default)"},
      {"do": "key", "press": "Alt+O"},
      {"do": "wait", "cond": "() => !document.querySelector('#overviewWrap').classList.contains('hidden')", "timeout": 15, "err": "the whole session in one strip"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p2-add", "steps": [
      {"do": "caption", "text": "Edit > Add Hit at Playhead"},
      {"do": "zoom_to", "track": "s_top", "t": 56.7, "span": 0.5},
      {"do": "lane_click", "track": "s_top", "lane": "wave", "t": 56.7,
       "err": "the playhead in the gap (no hit within 0.6 s there, the detector missed one)"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "6", "err": "the 5 ms preset at the playhead: the hit wide enough to see"},
      {"do": "wait", "cond": "() => S.view && (S.view.t1 - S.view.t0) <= 0.006", "timeout": 15, "err": "the 5 ms window"},
      {"do": "hold", "s": 1.5},
      {"do": "shot"},
      {"do": "key", "press": "H"},
      {"do": "hold", "s": 1.5},
      {"do": "shot"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p2-delete", "steps": [
      {"do": "caption", "text": "Edit > Delete Hit"},
      {"do": "zoom_to", "track": "s_top", "t": 8.5938, "span": 0.5},
      {"do": "lane_click", "track": "s_top", "lane": "spike", "t": 8.5938,
       "err": "the playhead on the hit (Tab takes the next hit from the playhead, not from where an earlier scene left it)"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "6"},
      {"do": "wait", "cond": "() => S.view && (S.view.t1 - S.view.t0) <= 0.006", "timeout": 15, "err": "the 5 ms window"},
      {"do": "hold", "s": 1.5},
      {"do": "shot"},
      {"do": "key", "press": "Tab"},
      {"do": "wait", "cond": "() => !document.querySelector('#ilFields').classList.contains('hidden') && document.querySelector('#ilSample').value.length > 0", "timeout": 15, "err": "the hit selected"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Delete"},
      {"do": "hold", "s": 1.5},
      {"do": "shot"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p2-nudge", "steps": [
      {"do": "caption", "text": "Edit > Nudge Value > 1 Sample"},
      {"do": "zoom_to", "track": "s_top", "t": 9.5312, "span": 0.5},
      {"do": "lane_click", "track": "s_top", "lane": "spike", "t": 9.5312,
       "err": "the playhead on the hit the nudge moves"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "6"},
      {"do": "wait", "cond": "() => S.view && (S.view.t1 - S.view.t0) <= 0.006", "timeout": 15, "err": "the 5 ms window"},
      {"do": "hold", "s": 1.5},
      {"do": "shot"},
      {"do": "select", "sel": "#nudgeSel", "value": "1smp", "timeout": 15, "err": "the nudge value 1 Sample"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Tab"},
      {"do": "wait", "cond": "() => !document.querySelector('#ilFields').classList.contains('hidden') && document.querySelector('#ilSample').value.length > 0", "timeout": 15, "err": "the hit selected"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "A"},
      {"do": "hold", "s": 1.5},
      {"do": "shot"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p2-undo", "area_sel": ".track[data-name=\"s_top\"]", "steps": [
      {"do": "caption", "text": "Edit > Undo History…"},
      {"do": "zoom_to", "track": "s_top", "t": 8.5938, "span": 5},
      {"do": "key", "press": "Meta+Z"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Shift+Meta+Z"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Alt+Meta+Z"},
      {"do": "hold", "s": 3.0},
      {"do": "click", "sel": "#undoHistDone"},
      {"do": "wait", "cond": "() => document.querySelector('#undoHistModal').classList.contains('hidden')", "timeout": 15, "err": "the undo history closed"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p2-velocity", "steps": [
      {"do": "caption", "text": "View > Velocity Lane"},
      {"do": "key", "press": "V"},
      {"do": "wait", "cond": "() => typeof VL !== 'undefined' && VL.on", "timeout": 15, "err": "the velocity lane"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p2-shape", "steps": [
      {"do": "caption", "text": "Edit > Recompute Velocities"},
      {"do": "wait", "cond": "() => document.querySelector('.insSec[data-sec=\"velocity\"] .insSecHead').getAttribute('aria-expanded') === 'true'", "timeout": 15, "err": "the Velocity section open: floor, ceiling, Loudness cut"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p2-end", "steps": [
      {"do": "caption", "text": "Next: doubtful hits first"},
      {"do": "hold", "s": 1.5}
    ]}
  ]
}
