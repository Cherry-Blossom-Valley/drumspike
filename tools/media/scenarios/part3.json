{
  "name": "part3",
  "title": "Screen recording, part 3: followers, layers and tempo (#337)",
  "script": "docs/product/scripts/rec-part3.md",
  "standard": true,
  "drift_limit_ms": 10,
  "viewport": {"width": 1920, "height": 1080},
  "device_scale_factor": 2,
  "skip": [],
  "seed": "demo",
  "narration": {"tts_out": "~/.cache/drumspike/media/tts-out/rec-part3"},
  "out": "~/.cache/drumspike/media/rec/part3.mp4",
  "session_files": [{"from": "{demo}/k out.wav", "as": "k sub.wav"}],
  "scenes": [
    {"id": "p3-follow", "area_sel": "#editor", "steps": [
      {"do": "caption", "text": "File > Add Tracks…"},
      {"do": "zoom_to", "track": "s_top", "t": 16.0938, "span": 5},
      {"do": "answer_pick", "path": "{session}/Audio Files"},
      {"do": "key", "press": "Shift+Meta+I"},
      {"do": "visible", "sel": "#tracksModal", "timeout": 30, "err": "the Add Tracks list"},
      {"do": "wait", "cond": "() => { const w = document.querySelector('#tracksRows .urow[data-stem=\"k sub\"] .ufollowWrap'); return w && !w.classList.contains('hidden') && w.querySelector('.ufollow').checked; }", "timeout": 30, "err": "the sub mic row has the follow check, on"},
      {"do": "hold", "s": 1.5},
      {"do": "click", "sel": "#tracksAdd", "timeout": 15, "err": "Add: the k sub track lands with the follow on"},
      {"do": "wait", "cond": "() => document.querySelector('#tracksModal').classList.contains('hidden') && !!document.querySelector('.track[data-name=\"k_sub\"]')", "timeout": 120, "err": "the dialog closed and the k sub track is in the session"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p3-follow2", "area_sel": ".track[data-name=\"k_sub\"]", "steps": [
      {"do": "caption", "text": "Track > Own Detection"},
      {"do": "click", "sel": ".track[data-name=\"k_sub\"] .thead .tname", "timeout": 15, "err": "the sub mic selected"},
      {"do": "hold", "s": 1.5},
      {"do": "menu", "id": "follow_own", "timeout": 15, "err": "Track > Own Detection"},
      {"do": "wait", "cond": "() => S.tracks['k_sub'] && !S.tracks['k_sub'].src", "timeout": 15, "err": "the sub mic detects its own hits again"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p3-layer", "area_sel": "#inspector", "steps": [
      {"do": "caption", "text": "The Layer section of the Inspector"},
      {"do": "click", "sel": ".insSec[data-sec=\"layer\"] .insSecHead", "timeout": 15, "err": "the Layer section of the Inspector"},
      {"do": "wait", "cond": "() => !!document.querySelector('.insSec[data-sec=\"layer\"] .lyZone')", "timeout": 15, "err": "the drop zone of the layer"},
      {"do": "hold", "s": 1.5},
      {"do": "answer_pick", "path": "{work}/one-shot.wav"},
      {"do": "click", "sel": ".insSec[data-sec=\"layer\"] .lyChoose", "timeout": 15, "err": "Choose…"},
      {"do": "text", "sel": ".insSec[data-sec=\"layer\"] .lyFile", "contains": "one-shot.wav", "timeout": 30, "err": "the one-shot in the zone"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p3-layer2", "area_sel": "#inspector", "steps": [
      {"do": "caption", "text": "The Onset view"},
      {"do": "click", "sel": ".insSec[data-sec=\"layer\"] .lyAlign", "timeout": 15, "err": "Align checked"},
      {"do": "wait", "cond": "() => !!document.querySelector('.insSec[data-sec=\"layer\"] .lyViewTitle')", "timeout": 30, "err": "the Onset view"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p3-tempo", "area_sel": "#editor", "steps": [
      {"do": "caption", "text": "Track > Detect Tempo…"},
      {"do": "zoom_to", "track": "s_top", "t": 16.0938, "span": 5},
      {"do": "hold", "s": 0.5},
      {"do": "menu", "id": "detect_tempo", "timeout": 15, "err": "Track > Detect Tempo…"},
      {"do": "visible", "sel": "#tempoModal", "timeout": 120, "err": "the Detect Tempo dialog: tempo, bar 1, meter, steps"},
      {"do": "wait", "cond": "() => document.querySelector('#tempoBody').children.length > 0", "timeout": 120, "err": "the detection filled the dialog (tempo, bar 1, meter, steps)"},
      {"do": "hold", "s": 2.0},
      {"do": "click", "sel": "#tempoAccept", "timeout": 15, "err": "Accept"},
      {"do": "wait", "cond": "() => document.querySelector('#tempoModal').classList.contains('hidden')", "timeout": 15, "err": "the dialog accepted"},
      {"do": "wait", "cond": "() => ((document.querySelector('#stMsg') || {}).textContent || '').startsWith('tempo map')", "timeout": 15, "err": "the detected map committed (the accept's commit is async; the next scene edits the map)"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p3-bar1", "steps": [
      {"do": "caption", "text": "Track > Set Bar 1 at Playhead"},
      {"do": "key", "press": "Tab"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Tab"},
      {"do": "hold", "s": 1.5},
      {"do": "menu", "id": "set_bar1", "timeout": 15, "err": "Track > Set Bar 1 at Playhead"},
      {"do": "wait", "cond": "() => TM.map && Math.abs((TM.map.bar1_s || 0) - S.playhead) < 0.001", "timeout": 15, "err": "bar 1 at the playhead"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p3-import", "area_sel": "#editor", "steps": [
      {"do": "caption", "text": "File > Import Tempo Map…"},
      {"do": "answer_pick", "path": "{work}/tempo.mid"},
      {"do": "menu", "id": "import_tempo_map", "timeout": 15, "err": "File > Import Tempo Map…"},
      {"do": "wait", "cond": "() => TM.map && Math.abs(TM.map.bpm - 87) < 0.5 && TM.map.changes && TM.map.changes.length > 0", "timeout": 15, "err": "the tempo map of the DAW file"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p3-grid", "area_sel": "#editor", "steps": [
      {"do": "caption", "text": "View > Show Bar and Beat Grid"},
      {"do": "key", "press": "G"},
      {"do": "hold", "s": 1.5},
      {"do": "menu", "id": "ruler_tempo", "timeout": 15, "err": "View > Tempo Ruler"},
      {"do": "hold", "s": 1.5},
      {"do": "menu", "id": "ruler_meter", "timeout": 15, "err": "View > Meter Ruler"},
      {"do": "hold", "s": 2.0}
    ]},
    {"id": "p3-click", "area_sel": "#clickBtn", "steps": [
      {"do": "caption", "text": "Transport > Metronome Click"},
      {"do": "key", "press": "C"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Space"},
      {"do": "wait", "cond": "() => S.playing", "timeout": 15, "err": "the click plays with the hits"},
      {"do": "hold", "s": 1.5},
      {"do": "key", "press": "Space"},
      {"do": "wait", "cond": "() => !S.playing", "timeout": 15, "err": "playback stopped"},
      {"do": "hold", "s": 1.5}
    ]},
    {"id": "p3-end", "steps": [
      {"do": "caption", "text": "Next: automate it"},
      {"do": "hold", "s": 1.5}
    ]}
  ]
}
